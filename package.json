    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@urql/core": "^6.0.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "mikro-ui": "^0.3.3",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
